<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CSS Styling — Lists, Tables & Forms</title>
<style>
  /* ---------- GLOBAL ---------- */
  * { box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f0f2f5;
    margin: 0;
    padding: 24px;
    color: #222;
  }
  h1 {
    font-size: 20px;
    margin: 36px 0 12px;
    color: #1a1a1a;
    border-left: 5px solid #6c5ce7;
    padding-left: 10px;
  }

  /* =====================================================
     TASK 1: Emoji Bullets, Custom Spacing & Hover Effect
     ===================================================== */
  .food-list {
    list-style: none;               /* remove default bullets */
    padding: 0;
    margin: 0;
    max-width: 420px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    padding: 16px 20px;
  }

  .food-list li {
    position: relative;
    padding: 12px 12px 12px 42px;   /* left space for the emoji */
    margin-bottom: 8px;             /* custom spacing between items */
    font-size: 17px;
    font-weight: 500;
    border-radius: 8px;
    transition: background 0.25s, color 0.25s, padding-left 0.25s;
    cursor: pointer;
  }

  /* Emoji bullet via ::before pseudo-element */
  .food-list li::before {
    content: attr(data-emoji);      /* pull emoji from HTML attribute */
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    transition: transform 0.25s;
  }

  /* Hover effect: change color + slide in slightly */
  .food-list li:hover {
    background: #ede9fe;
    color: #6c5ce7;
    padding-left: 50px;
  }
  .food-list li:hover::before {
    transform: translateY(-50%) scale(1.25);
  }

  /* =====================================================
     TASK 2: IPL Table — Zebra Striping, Rounded, Hover
     ===================================================== */
  .ipl-table {
    width: 100%;
    max-width: 780px;
    border-collapse: separate;      /* needed for rounded corners */
    border-spacing: 0;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;               /* clips children to rounded shape */
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
    font-size: 15px;
  }

  .ipl-table thead {
    background: linear-gradient(90deg, #6c5ce7, #a29bfe);
    color: #fff;
  }

  .ipl-table th,
  .ipl-table td {
    padding: 14px 16px;
    text-align: left;
  }

  .ipl-table th {
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    font-size: 13px;
  }

  .ipl-table tbody tr {
    transition: background 0.2s, transform 0.2s;
  }

  /* Zebra striping */
  .ipl-table tbody tr:nth-child(even) {
    background: #f6f5ff;
  }
  .ipl-table tbody tr:nth-child(odd) {
    background: #ffffff;
  }

  /* Row hover highlight */
  .ipl-table tbody tr:hover {
    background: #ffeaa7;
    transform: scale(1.005);
    box-shadow: inset 4px 0 0 #6c5ce7;
  }

  .winner {
    font-weight: 600;
    color: #00b894;
  }

  /* =====================================================
     TASK 3 & 4: Music App Sign-Up Form + Button Hover
     ===================================================== */
  .signup-wrapper {
    max-width: 460px;
    background: #fff;
    border-radius: 16px;
    padding: 28px 26px;
    box-shadow: 0 8px 24px rgba(108, 92, 231, 0.15);
    margin-bottom: 40px;
  }

  .signup-wrapper h2 {
    margin: 0 0 20px;
    font-size: 22px;
    color: #6c5ce7;
    text-align: center;
  }

  .form-group {
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
    color: #444;
  }

  .form-group input,
  .form-group select {
    padding: 12px 14px;
    font-size: 15px;
    border: 2px solid #dfe0e5;
    border-radius: 10px;                     /* consistent radius */
    outline: none;
    transition: border-color 0.2s, box-shadow 0.25s, transform 0.2s;
    background: #fafaff;
    font-family: inherit;
  }

  /* Focus state — matching border + glow */
  .form-group input:focus,
  .form-group select:focus {
    border-color: #6c5ce7;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.18);
  }

  /* Submit button — shares border-radius with inputs */
  .submit-btn {
    width: 100%;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    background: #6c5ce7;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 6px 14px rgba(108, 92, 231, 0.35);
    transition: background 0.25s ease,
                transform 0.25s ease,
                box-shadow 0.25s ease;
  }

  /* TASK 4: hover effect — color change + scale up */
  .submit-btn:hover {
    background: #4834d4;
    transform: scale(1.05);
    box-shadow: 0 10px 22px rgba(72, 52, 212, 0.45);
  }

  /* Subtle click feedback */
  .submit-btn:active {
    transform: scale(0.98);
  }
</style>
</head>
<body>

<!-- =========================================================
     TASK 1: Emoji-bulleted favourite foods
     ========================================================= -->
<h1>1. My Favourite Foods 🍽️</h1>
<ul class="food-list">
  <li data-emoji="🍕">Pizza Margherita</li>
  <li data-emoji="🍜">Ramen Noodles</li>
  <li data-emoji="🌮">Chicken Tacos</li>
  <li data-emoji="🍣">Sushi Platter</li>
  <li data-emoji="🍫">Chocolate Brownie</li>
</ul>

<!-- =========================================================
     TASK 2: IPL Table
     ========================================================= -->
<h1>2. Recent IPL Matches 🏏</h1>
<table class="ipl-table">
  <thead>
    <tr>
      <th>Team 1</th>
      <th>Team 2</th>
      <th>Score</th>
      <th>Winner</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Mumbai Indians</td>
      <td>Chennai Super Kings</td>
      <td>MI 182/6 – CSK 178/8</td>
      <td class="winner">Mumbai Indians</td>
    </tr>
    <tr>
      <td>Royal Challengers</td>
      <td>Kolkata Knight Riders</td>
      <td>RCB 201/4 – KKR 195/7</td>
      <td class="winner">Royal Challengers</td>
    </tr>
    <tr>
      <td>Gujarat Titans</td>
      <td>Rajasthan Royals</td>
      <td>GT 165/9 – RR 168/5</td>
      <td class="winner">Rajasthan Royals</td>
    </tr>
  </tbody>
</table>

<!-- =========================================================
     TASKS 3 & 4: Music App Sign-Up Form
     ========================================================= -->
<h1>3 &amp; 4. Music App Sign-Up 🎵</h1>
<div class="signup-wrapper">
  <h2>Create Your Account</h2>
  <form onsubmit="event.preventDefault(); alert('Signed up! 🎶');">
    <div class="form-group">
      <label for="username">Username</label>
      <input type="text" id="username" placeholder="e.g. melody_master" required>
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" placeholder="you@example.com" required>
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" placeholder="••••••••" minlength="6" required>
    </div>

    <div class="form-group">
      <label for="genre">Favourite Genre</label>
      <select id="genre" required>
        <option value="">-- Select a genre --</option>
        <option>Pop</option>
        <option>Rock</option>
        <option>Hip-Hop</option>
        <option>Jazz</option>
        <option>Classical</option>
        <option>EDM</option>
      </select>
    </div>

    <button type="submit" class="submit-btn">Sign Up 🎧</button>
  </form>
</div>

</body>
</html>
